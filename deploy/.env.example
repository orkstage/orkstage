# OrkStage production settings for compose.yaml. Copy to .env and fill in every empty value.
# Generate secrets with: openssl rand -base64 32

# Release to run (https://github.com/orkstage/orkstage-dev/releases lists them as image tags).
ORKSTAGE_VERSION=0.1.0
# Public host name that points to this machine (ports 80 and 443 open).
ORKSTAGE_DOMAIN=orkstage.example.com

# Runs Postgres and Redis next to OrkStage. Remove this line to use managed ones, and set
# DATABASE_URL and REDIS_URL below.
COMPOSE_PROFILES=bundled
# Letters and digits only (it goes into a connection URL).
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://user:password@host:5432/orkstage
# REDIS_URL=redis://host:6379

# Required. At least 32 characters.
SESSION_SECRET=
# Required. 32 bytes in base64: encrypts the secrets OrkStage derives for your resources.
ENCRYPTION_KEY=

# The first platform owner: their first single sign on with this verified email gets the role.
PLATFORM_OWNER_EMAIL=

# Single sign on (OIDC); production has no development login. Any provider works with three
# variables named after it, OIDC_<NAME>_ISSUER, _CLIENT_ID and _CLIENT_SECRET (for example
# OIDC_GOOGLE_*). The redirect URL to register is https://<ORKSTAGE_DOMAIN>/api/v1/auth/oidc/<name>/callback.
OIDC_ENTRA_ISSUER=
OIDC_ENTRA_CLIENT_ID=
OIDC_ENTRA_CLIENT_SECRET=

# Email for invitations and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OrkStage <orkstage@example.com>

# OrkStage Enterprise: the license key turns on the features of your subscription.
# ORKSTAGE_LICENSE_KEY=

LOG_LEVEL=info
