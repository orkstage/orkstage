# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: terraform-starter-standard
  version: 0.1.0
  displayName: Terraform starter standard
  description: Imported by orkstage-scan from terraform (1).
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
  variables:
    - name: apiReplicas
      type: number
      default: 1
      min: 1
      max: 2
      target: api.replicas
    - name: databaseSize
      type: string
      default: small
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # from terraform aws_vpc.main (main.tf:28)
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 2
    # from terraform aws_ecr_repository.registry (main.tf:68)
    - id: registry
      type: container-registry
      implementation: ecr
      scanOnPush: true
      immutableTags: true
    # from terraform aws_ecs_service.api (main.tf:162); terraform aws_ecs_task_definition.api (main.tf:126) | image 123456789012.dkr.ecr.us-east-1.amazonaws.com/sample-api:1.4.0: publish it to the catalog as api
    - id: api
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://api
      replicas: 1
      cpu: 0.5
      memoryMiB: 1024
      port: 8080
      public: true
      healthCheckPath: /health
    # from terraform aws_ecs_service.worker (main.tf:179); terraform aws_ecs_task_definition.worker (main.tf:145) | image 123456789012.dkr.ecr.us-east-1.amazonaws.com/sample-worker:1.4.0: publish it to the catalog as worker
    - id: worker
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://worker
      replicas: 1
      cpu: 0.25
      memoryMiB: 512
      critical: false
    # from terraform aws_db_instance.database (main.tf:82)
    - id: database
      type: database.postgresql
      implementation: rds-postgres
      version: "17"
      size: small
      storageGiB: 20
      backup: { enabled: true, retentionDays: 7 }
    # from terraform aws_elasticache_replication_group.cache (main.tf:100)
    - id: cache
      type: cache.redis
      implementation: elasticache-valkey
      size: micro
    # from terraform aws_sqs_queue.messaging (main.tf:113); terraform aws_sqs_queue.messaging_dlq (main.tf:109)
    - id: messaging
      type: queue
      implementation: sqs
      deadLetter: true
    # from terraform aws_lb.ingress (main.tf:191); terraform aws_lb_listener.https (main.tf:214)
    - id: ingress
      type: ingress
      implementation: alb
      routes:
        - { service: api }
      tls: true
    # from terraform aws_route53_zone.main (main.tf:225); terraform aws_route53_record.app (main.tf:229)
    - id: dns
      type: dns
      implementation: route53
      target: ingress
      customDomain: optional
  connectivity:
    - { from: api, to: cache, protocol: redis, port: 6379, mode: private-required }
    - { from: api, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: api, to: messaging, protocol: https, mode: secure }
    - { from: worker, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: worker, to: messaging, protocol: https, mode: secure }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
