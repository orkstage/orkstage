# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: compose-app
  version: 0.1.0
  displayName: Compose app
  description: "Imported by orkstage-scan from compose (1), dockerfile (2), package (2)."
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: "Everything detected; no cloud provider was evident, bind any target."
  variables:
    - name: apiReplicas
      type: number
      default: 2
      min: 1
      max: 4
      target: api.replicas
    - name: databaseSize
      type: string
      default: small
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      availabilityZones: 2
    # from compose services.api (docker-compose.yml:5); dockerfile Dockerfile (api/Dockerfile:9)
    - id: api
      type: compute.container-service
      image: catalog://api
      replicas: 2
      cpu: 0.5
      memoryMiB: 1024
      port: 8080
      public: true
      healthCheckPath: /health
    # from compose services.worker (docker-compose.yml:18); dockerfile Dockerfile (worker/Dockerfile:1)
    - id: worker
      type: compute.container-service
      image: catalog://worker
      replicas: 1
      cpu: 0.25
      memoryMiB: 512
      critical: false
    # from compose services.db (docker-compose.yml:27); package pg (api/package.json:3); package psycopg (worker/requirements.txt:1)
    - id: database
      type: database.postgresql
      version: "17"
      size: small
      storageGiB: 20
      backup: { enabled: true, retentionDays: 7 }
    # from compose services.cache (docker-compose.yml:30); package ioredis (api/package.json:3)
    - id: cache
      type: cache.redis
      size: micro
    # from compose services.queue (docker-compose.yml:32); package amqplib (api/package.json:3)
    - id: messaging
      type: queue
      deadLetter: true
    # from compose services.storage (docker-compose.yml:34); package boto3-stubs (worker/requirements.txt:2)
    - id: storage
      type: object-storage
      tier: standard
      versioning: false
  connectivity:
    - { from: api, to: cache, protocol: redis, port: 6379, mode: private-required }
    - { from: api, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: api, to: messaging, protocol: amqp, port: 5672, mode: private-required }
    - { from: worker, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: worker, to: messaging, protocol: amqp, port: 5672, mode: private-required }
    - { from: worker, to: storage, protocol: https, mode: secure }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
