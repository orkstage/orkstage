---
source: crates/orkstage-scan/tests/fixtures.rs
---
version: 1
generator: orkstage-scan/0.1.0
detectors:
  - kind: kubernetes
    files: 2
resources:
  - id: network
    type: network
    provider: ~
    properties:
      availabilityZones: 2
      natGateway: false
      inferred: true
    sources: []
    confidence: low
  - id: api
    type: compute.container-service
    provider: ~
    properties:
      sourceImage: "ghcr.io/acme/api:1.9.0"
      replicas: 3
      cpu: 0.5
      memoryMiB: 1024
      port: 8080
      healthCheckPath: /ready
      autoscaling:
        minReplicas: 3
        maxReplicas: 10
        targetCpuPercent: 65
      public: true
    sources:
      - kind: kubernetes
        file: api.yaml
        line: 2
        address: Deployment/api
    confidence: medium
  - id: database
    type: database.postgresql
    provider: ~
    properties:
      version: "16"
      storageGiB: 50
    sources:
      - kind: kubernetes
        file: data.yaml
        line: 2
        address: StatefulSet/postgres
    confidence: medium
  - id: cache
    type: cache.redis
    provider: ~
    properties: {}
    sources:
      - kind: kubernetes
        file: data.yaml
        line: 34
        address: Deployment/redis
    confidence: medium
  - id: ingress
    type: ingress
    provider: ~
    properties:
      tls: true
      routes:
        - service: api
          pathPrefix: /
    sources:
      - kind: kubernetes
        file: api.yaml
        line: 41
        address: Ingress/public
    confidence: medium
  - id: dns
    type: dns
    provider: ~
    properties:
      customDomain: optional
      target: ingress
    sources:
      - kind: kubernetes
        file: api.yaml
        line: 41
        address: Ingress/public
    confidence: medium
unmapped:
  - source:
      kind: kubernetes
      file: data.yaml
      line: 57
      address: CronJob/nightly-report
    type: CronJob
    reason: batch jobs are not supported yet
connections:
  - from: api
    to: cache
    protocol: redis
    port: 6379
    evidence: api env REDIS_URL mentions redis
  - from: api
    to: database
    protocol: postgres
    port: 5432
    evidence: api env DATABASE_URL mentions postgres
template: "<see the __template snapshot>"
warnings:
  - "network inferred: no network was declared but services and data stores need one"
