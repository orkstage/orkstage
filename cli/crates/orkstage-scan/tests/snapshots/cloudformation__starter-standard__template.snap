# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: cloudformation-starter-standard
  version: 0.1.0
  displayName: Cloudformation starter standard
  description: Imported by orkstage-scan from cloudformation (1).
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
  variables:
    - name: apiReplicas
      type: number
      default: 1
      min: 1
      max: 2
      target: api.replicas
    - name: databaseSize
      type: string
      default: small
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # from cloudformation Vpc (template.yaml:15)
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 2
    # from cloudformation Registry (template.yaml:32)
    - id: registry
      type: container-registry
      implementation: ecr
      scanOnPush: true
      immutableTags: true
    # from cloudformation Api (template.yaml:106); cloudformation ApiTask (template.yaml:71) | image 123456789012.dkr.ecr.us-east-1.amazonaws.com/sample-api:1.4.0: publish it to the catalog as api
    - id: api
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://api
      replicas: 1
      cpu: 0.5
      memoryMiB: 1024
      port: 8080
      public: true
      healthCheckPath: /health
    # from cloudformation Worker (template.yaml:118); cloudformation WorkerTask (template.yaml:91) | image 123456789012.dkr.ecr.us-east-1.amazonaws.com/sample-worker:1.4.0: publish it to the catalog as worker
    - id: worker
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://worker
      replicas: 1
      cpu: 0.25
      memoryMiB: 512
      critical: false
    # from cloudformation Database (template.yaml:40)
    - id: database
      type: database.postgresql
      implementation: rds-postgres
      version: "17"
      size: small
      storageGiB: 20
      backup: { enabled: true, retentionDays: 7 }
    # from cloudformation Cache (template.yaml:52)
    - id: cache
      type: cache.redis
      implementation: elasticache-valkey
      size: micro
    # from cloudformation Messaging (template.yaml:62); cloudformation MessagingDlq (template.yaml:60)
    - id: messaging
      type: queue
      implementation: sqs
      deadLetter: true
    # from cloudformation Ingress (template.yaml:127); cloudformation HttpsListener (template.yaml:144)
    - id: ingress
      type: ingress
      implementation: alb
      routes:
        - { service: api }
      tls: true
    # from cloudformation Dns (template.yaml:156)
    - id: dns
      type: dns
      implementation: route53
      target: ingress
      customDomain: optional
  connectivity:
    - { from: api, to: cache, protocol: redis, port: 6379, mode: private-required }
    - { from: api, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: api, to: messaging, protocol: https, mode: secure }
    - { from: worker, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: worker, to: messaging, protocol: https, mode: secure }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
