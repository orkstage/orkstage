source: crates/orkstage-scan/tests/fixtures.rs
---
# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: mixed-other-iac
  version: 0.1.0
  displayName: Mixed other iac
  description: "Imported by orkstage-scan from serverless (1), pulumi (2), bicep (1), arm (1)."
  profile: growth
spec:
  plans: [GROWTH, SCALE]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
    - name: data
      description: Data resources detected on azure.
      providers: [azure]
    - name: messaging
      description: Messaging resources detected on azure.
      providers: [azure]
    - name: storage
      description: Storage resources detected on azure.
      providers: [azure]
  variables:
    - name: shopDbSize
      type: string
      default: small
      allowed: [micro, small, medium, large, xlarge]
      target: shop-db.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 1
    # from pulumi awsx.ecs.FargateService(shop-web) (pulumi/index.ts:6)
    - id: shop-web
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://shop-web
      replicas: 1
      cpu: 0.25
      memoryMiB: 512
      critical: false
    # from pulumi aws.rds.Instance(shop-db) (pulumi/index.ts:4)
    - id: shop-db
      type: database.postgresql
      implementation: rds-postgres
      version: "17"
      size: small
      storageGiB: 20
      backup: { enabled: true, retentionDays: 7 }
    # from bicep server (Microsoft.DBforPostgreSQL/flexibleServers) (bicep/main.bicep:8)
    - id: shop-pg
      type: database.postgresql
      placement: data
      implementation: flexible-server
      version: "17"
      size: small
      storageGiB: 20
      backup: { enabled: true, retentionDays: 7 }
    # from bicep cache (Microsoft.Cache/redis) (bicep/main.bicep:2)
    - id: cache
      type: cache.redis
      placement: data
      implementation: azure-cache-redis
      size: micro
    # from serverless NotificationsQueue (serverless/serverless.yml:10)
    - id: notifications
      type: queue
      implementation: sqs
      deadLetter: false
    # from arm orders (arm/azuredeploy.json)
    - id: orders
      type: queue
      placement: messaging
      implementation: service-bus
      deadLetter: true
    # from pulumi aws.s3.BucketV2(shop-assets) (pulumi/index.ts:5)
    - id: shop-assets
      type: object-storage
      implementation: s3
      tier: standard
      versioning: false
    # from arm shopdocs (arm/azuredeploy.json)
    - id: shopdocs
      type: object-storage
      placement: storage
      implementation: blob-storage
      tier: standard
      versioning: false
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
