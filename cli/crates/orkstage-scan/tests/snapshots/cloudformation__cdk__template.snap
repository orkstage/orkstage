# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: cloudformation-cdk
  version: 0.1.0
  displayName: Cloudformation cdk
  description: Imported by orkstage-scan from cdk (1).
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
  variables:
    - name: databaseSize
      type: string
      default: large
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 2
    # from cdk OrdersDbCluster1A2B3C (cdk.out/OrdersStack.template.json); cdk OrdersDbClusterWriter4D5E6F (cdk.out/OrdersStack.template.json); cdk OrdersDbClusterReader7G8H9I (cdk.out/OrdersStack.template.json)
    - id: database
      type: database.postgresql
      implementation: rds-postgres
      version: "16"
      size: large
      storageGiB: 20
      highAvailability: zone-redundant
      backup: { enabled: true, retentionDays: 7 }
    # from cdk OrdersQueue0A1B2C (cdk.out/OrdersStack.template.json)
    - id: messaging
      type: queue
      implementation: sqs
      deadLetter: false
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
