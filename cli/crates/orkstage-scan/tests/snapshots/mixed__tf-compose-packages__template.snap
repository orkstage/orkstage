# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: mixed-tf-compose-packages
  version: 0.1.0
  displayName: Mixed tf compose packages
  description: "Imported by orkstage-scan from terraform (1), compose (1), dockerfile (1), package (1)."
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
  variables:
    - name: appReplicas
      type: number
      default: 2
      min: 1
      max: 4
      target: app.replicas
    - name: databaseSize
      type: string
      default: medium
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 2
    # from terraform aws_ecs_service.app (infra/main.tf:9); compose services.app (docker-compose.yml:2); dockerfile Dockerfile (app/Dockerfile:2)
    - id: app
      type: compute.container-service
      implementation: ecs-ec2
      image: catalog://app
      replicas: 2
      cpu: 0.25
      memoryMiB: 512
      port: 3000
      public: true
    # from terraform aws_db_instance.orders (infra/main.tf:1); compose services.postgres (docker-compose.yml:6); package pg (app/package.json:1)
    - id: database
      type: database.postgresql
      implementation: rds-postgres
      version: "17"
      size: medium
      storageGiB: 50
      backup: { enabled: true, retentionDays: 7 }
    # from package @aws-sdk/client-sqs (app/package.json:1)
    - id: messaging
      type: queue
      deadLetter: true
    # inferred (no declaration found); review
    - id: ingress
      type: ingress
      implementation: alb
      routes:
        - { service: app }
      tls: true
    # inferred (no declaration found); review
    - id: dns
      type: dns
      implementation: route53
      target: ingress
      customDomain: disabled
  connectivity:
    - { from: app, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: app, to: messaging, protocol: https, mode: secure }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
