# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: terraform-azure-gcp
  version: 0.1.0
  displayName: Terraform azure gcp
  description: Imported by orkstage-scan from terraform (2).
  profile: scale
spec:
  plans: [SCALE]
  placements:
    - name: primary
      description: Application runtime and everything detected on azure.
      providers: [azure]
    - name: data
      description: Data resources detected on gcp.
      providers: [gcp]
    - name: storage
      description: Storage resources detected on gcp.
      providers: [gcp]
  variables:
    - name: webReplicas
      type: number
      default: 2
      min: 1
      max: 4
      target: web.replicas
    - name: analyticsSize
      type: string
      default: large
      allowed: [micro, small, medium, large, xlarge]
      target: analytics.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      implementation: vnet
      availabilityZones: 2
    # from terraform azurerm_container_app.web (azure.tf:30) | image shopacr.azurecr.io/web:3.0: publish it to the catalog as web
    - id: web
      type: compute.container-service
      implementation: container-apps
      image: catalog://web
      replicas: 2
      cpu: 0.5
      memoryMiB: 1024
      port: 8000
      public: true
    # from terraform google_sql_database_instance.analytics (gcp.tf.json:4)
    - id: analytics
      type: database.postgresql
      placement: data
      version: "15"
      size: large
      storageGiB: 200
      highAvailability: zone-redundant
      backup: { enabled: true, retentionDays: 7 }
    # from terraform azurerm_postgresql_flexible_server.db (azure.tf:6)
    - id: db
      type: database.postgresql
      implementation: flexible-server
      version: "16"
      size: medium
      storageGiB: 64
      highAvailability: zone-redundant
      backup: { enabled: true, retentionDays: 14 }
    # from terraform google_storage_bucket.exports (gcp.tf.json:16)
    - id: exports
      type: object-storage
      placement: storage
      tier: infrequent
      versioning: true
    # from terraform azurerm_storage_account.files (azure.tf:19)
    - id: files
      type: object-storage
      implementation: blob-storage
      tier: standard
      versioning: true
    # inferred (no declaration found); review
    - id: ingress
      type: ingress
      implementation: application-gateway
      routes:
        - { service: web }
      tls: true
    # inferred (no declaration found); review
    - id: dns
      type: dns
      implementation: azure-dns
      target: ingress
      customDomain: disabled
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
