# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: kubernetes-manifests
  version: 0.1.0
  displayName: Kubernetes manifests
  description: Imported by orkstage-scan from kubernetes (2).
  profile: scale
spec:
  plans: [SCALE]
  placements:
    - name: primary
      description: "Everything detected; no cloud provider was evident, bind any target."
  variables:
    - name: databaseSize
      type: string
      default: small
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      availabilityZones: 2
    # from kubernetes Deployment/api (api.yaml:2) | image ghcr.io/acme/api:1.9.0: publish it to the catalog as api
    - id: api
      type: compute.container-service
      image: catalog://api
      replicas: 3
      cpu: 0.5
      memoryMiB: 1024
      port: 8080
      public: true
      healthCheckPath: /ready
      autoscaling: { minReplicas: 3, maxReplicas: 10, targetCpuPercent: 65 }
    # from kubernetes StatefulSet/postgres (data.yaml:2)
    - id: database
      type: database.postgresql
      version: "16"
      size: small
      storageGiB: 50
      backup: { enabled: true, retentionDays: 7 }
    # from kubernetes Deployment/redis (data.yaml:34)
    - id: cache
      type: cache.redis
      size: micro
    # from kubernetes Ingress/public (api.yaml:41)
    - id: ingress
      type: ingress
      routes:
        - { service: api }
      tls: true
    # from kubernetes Ingress/public (api.yaml:41)
    - id: dns
      type: dns
      target: ingress
      customDomain: optional
  connectivity:
    - { from: api, to: cache, protocol: redis, port: 6379, mode: private-required }
    - { from: api, to: database, protocol: postgres, port: 5432, mode: private-required }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
