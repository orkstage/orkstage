# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: mixed-multicloud
  version: 0.1.0
  displayName: Mixed multicloud
  description: Imported by orkstage-scan from terraform (3).
  profile: growth
spec:
  plans: [GROWTH, SCALE]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
    - name: data
      description: Data resources detected on azure.
      providers: [azure]
    - name: storage
      description: Storage resources detected on oci.
      providers: [oci]
  variables:
    - name: apiReplicas
      type: number
      default: 2
      min: 1
      max: 4
      target: api.replicas
    - name: databaseSize
      type: string
      default: medium
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # from terraform aws_vpc.main (aws.tf:1)
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 1
    # from terraform aws_ecr_repository.apps (aws.tf:5)
    - id: registry
      type: container-registry
      implementation: ecr
      scanOnPush: false
      immutableTags: false
    # from terraform aws_ecs_service.api (aws.tf:25); terraform aws_ecs_task_definition.api (aws.tf:9) | image acme/api:1: publish it to the catalog as api
    - id: api
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://api
      replicas: 2
      cpu: 0.5
      memoryMiB: 1024
      port: 8080
      public: true
    # from terraform azurerm_postgresql_flexible_server.data (azure.tf:1)
    - id: database
      type: database.postgresql
      placement: data
      implementation: flexible-server
      version: "17"
      size: medium
      storageGiB: 50
      highAvailability: zone-redundant
      backup: { enabled: true, retentionDays: 7 }
    # from terraform oci_objectstorage_bucket.files (oci.tf:1)
    - id: storage
      type: object-storage
      placement: storage
      implementation: object-storage
      tier: standard
      versioning: true
    # inferred (no declaration found); review
    - id: ingress
      type: ingress
      implementation: alb
      routes:
        - { service: api }
      tls: true
    # inferred (no declaration found); review
    - id: dns
      type: dns
      implementation: route53
      target: ingress
      customDomain: disabled
  connectivity:
    - { from: api, to: database, protocol: postgres, port: 5432, mode: private-preferred }
    - { from: api, to: storage, protocol: https, mode: secure }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
