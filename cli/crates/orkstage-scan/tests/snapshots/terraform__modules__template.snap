# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: terraform-modules
  version: 0.1.0
  displayName: Terraform modules
  description: Imported by orkstage-scan from terraform (4).
  profile: growth
spec:
  plans: [GROWTH, SCALE]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
  variables:
    - name: databaseSize
      type: string
      default: large
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # from terraform aws_vpc.this (modules/network/main.tf:5)
    - id: network
      type: network
      implementation: vpc
      availabilityZones: 3
      natGateway: true
    # from terraform aws_ecs_service.this (modules/service/main.tf:22); terraform aws_ecs_task_definition.this (modules/service/main.tf:9) | image ghcr.io/acme/orders-api:2.1.0: publish it to the catalog as api
    - id: api
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://api
      replicas: 3
      cpu: 1.0
      memoryMiB: 2048
      port: 3000
    # from terraform aws_ecs_service.this (modules/service/main.tf:22); terraform aws_ecs_task_definition.this (modules/service/main.tf:9) | image ghcr.io/acme/orders-worker:2.1.0: publish it to the catalog as worker
    - id: worker
      type: compute.container-service
      implementation: ecs-fargate
      image: catalog://worker
      replicas: 2
      cpu: 0.25
      memoryMiB: 512
      critical: false
    # from terraform aws_db_instance.this (modules/db/main.tf:5)
    - id: database
      type: database.postgresql
      implementation: rds-postgres
      version: "16"
      size: large
      storageGiB: 100
      highAvailability: zone-redundant
      backup: { enabled: true, retentionDays: 14 }
  connectivity:
    - { from: api, to: database, protocol: postgres, port: 5432, mode: private-required }
    - { from: worker, to: database, protocol: postgres, port: 5432, mode: private-required }
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
