# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: kubernetes-helm
  version: 0.1.0
  displayName: Kubernetes helm
  description: Imported by orkstage-scan from helm (4).
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: "Everything detected; no cloud provider was evident, bind any target."
  variables:
    - name: shopReplicas
      type: number
      default: 1
      min: 1
      max: 2
      target: shop.replicas
    - name: databaseSize
      type: string
      default: small
      allowed: [micro, small, medium, large, xlarge]
      target: database.size
  resources:
    # inferred (no declaration found); review
    - id: network
      type: network
      availabilityZones: 1
    # from helm Deployment/shop (chart/templates/deployment.yaml:2) | image helm-value:helm-value: publish it to the catalog as shop
    - id: shop
      type: compute.container-service
      image: catalog://shop
      replicas: 1
      cpu: 0.25
      memoryMiB: 512
      port: 3000
      public: true
      healthCheckPath: /healthz
    # from helm dependency/postgresql (chart/Chart.yaml:4)
    - id: database
      type: database.postgresql
      version: "17"
      size: small
      storageGiB: 20
      backup: { enabled: true, retentionDays: 7 }
    # from helm dependency/redis (chart/Chart.yaml:4)
    - id: cache
      type: cache.redis
      size: micro
    # from helm Service/shop (chart/templates/service.yaml:2)
    - id: ingress
      type: ingress
      routes:
        - { service: shop }
      tls: true
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
