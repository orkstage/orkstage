# Generated by orkstage-scan/0.1.0. Review before publishing:
# images are catalog references named after each service; sizes not found in the sources use defaults.
apiVersion: platform/v1
kind: EnvironmentTemplate
metadata:
  name: cloudformation-sam
  version: 0.1.0
  displayName: Cloudformation sam
  description: Imported by orkstage-scan from sam (1).
  profile: starter
spec:
  plans: [STARTER, GROWTH]
  placements:
    - name: primary
      description: Application runtime and everything detected on aws.
      providers: [aws]
  resources:
    # from sam Jobs (template.yaml:12)
    - id: messaging
      type: queue
      implementation: sqs
      fifo: true
      deadLetter: false
    # from sam Uploads (template.yaml:4)
    - id: storage
      type: object-storage
      implementation: s3
      tier: standard
      versioning: true
      retentionDays: 90
  observability: { logs: true, metrics: true, traces: false, uptime: true, alerts: true }
