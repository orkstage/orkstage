{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeDeploymentRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/orkstage-deploy"
    },
    {
      "Sid": "ReadExternalIds",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:*:*:secret:orkstage/*"
    }
  ]
}
