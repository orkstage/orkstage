# Copy to .env at the repo root. Never commit real secrets.

NODE_ENV=development

# --- Control plane storage ---
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# 32+ random bytes, base64. Used to sign session cookies.
SESSION_SECRET=change-me-in-real-environments-0123456789abcdef
# Enables POST /api/v1/auth/dev-login. Refused at startup when NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true

# --- OIDC (Microsoft Entra ID). Leave blank to disable. ---
OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ENTRA_CLIENT_ID=
OIDC_ENTRA_CLIENT_SECRET=

# --- Worker ---
WORKER_CONCURRENCY=4
# OpenTofu runs in throwaway containers (needs Docker). The network lets the runner reach the
# local AWS emulator (MiniStack) by its compose service name.
TOFU_IMAGE=ghcr.io/opentofu/opentofu:1.12.7
TOFU_DOCKER_NETWORK=cloud-orchestrator_default

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="OrkStage <noreply@example.local>"

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
