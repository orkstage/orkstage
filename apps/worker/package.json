{
  "name": "@orkstage/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orkstage/cloud-core": "workspace:*",
    "@orkstage/contracts": "workspace:*",
    "@orkstage/database": "workspace:*",
    "@orkstage/domain": "workspace:*",
    "@orkstage/provisioning": "workspace:*",
    "@orkstage/runtime": "workspace:*",
    "@orkstage/templates": "workspace:*",
    "bullmq": "6.3.15",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@orkstage/cloud-mock": "workspace:*",
    "@types/nodemailer": "8.0.2"
  }
}
