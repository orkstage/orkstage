{
  "name": "@orkstage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@orkstage/authorization": "workspace:*",
    "@orkstage/cloud-core": "workspace:*",
    "@orkstage/cloud-mock": "workspace:*",
    "@orkstage/contracts": "workspace:*",
    "@orkstage/database": "workspace:*",
    "@orkstage/domain": "workspace:*",
    "@orkstage/licensing": "workspace:*",
    "@orkstage/provisioning": "workspace:*",
    "@orkstage/runtime": "workspace:*",
    "@orkstage/templates": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.7",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "bullmq": "6.5.0",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
