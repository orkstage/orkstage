{
  "name": "@orkstage/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node scripts/telemetry-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1157.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-ioredis": "0.72.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orkstage/cloud-aws": "workspace:*",
    "@orkstage/cloud-azure": "workspace:*",
    "@orkstage/cloud-core": "workspace:*",
    "@orkstage/cloud-coreweave": "workspace:*",
    "@orkstage/cloud-digitalocean": "workspace:*",
    "@orkstage/cloud-gcp": "workspace:*",
    "@orkstage/cloud-magalu": "workspace:*",
    "@orkstage/cloud-mock": "workspace:*",
    "@orkstage/cloud-oci": "workspace:*",
    "@orkstage/cloud-render": "workspace:*",
    "@orkstage/cloud-supabase": "workspace:*",
    "@orkstage/cloud-vercel": "workspace:*",
    "@orkstage/cloud-vultr": "workspace:*",
    "@orkstage/database": "workspace:*",
    "@orkstage/domain": "workspace:*",
    "@orkstage/iac": "workspace:*",
    "@orkstage/provisioning": "workspace:*",
    "@prisma/instrumentation": "7.10.1",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "files": [
    "dist"
  ]
}
