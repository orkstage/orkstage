{
  "name": "@co/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@co/cloud-aws": "workspace:*",
    "@co/cloud-core": "workspace:*",
    "@co/cloud-mock": "workspace:*",
    "@co/domain": "workspace:*",
    "@co/iac": "workspace:*",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  }
}
