{
  "name": "@orkstage/templates",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builtin": {
      "types": "./dist/builtin.d.ts",
      "default": "./dist/builtin.js"
    }
  },
  "files": [
    "dist",
    "builtin",
    "marketplace"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@orkstage/domain": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orkstage/orkstage.git",
    "directory": "packages/templates"
  },
  "license": "AGPL-3.0-only"
}
