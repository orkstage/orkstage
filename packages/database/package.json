{
  "name": "@orkstage/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "test": "echo \"database: covered by API integration tests\""
  },
  "dependencies": {
    "@orkstage/domain": "workspace:*",
    "@orkstage/templates": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "7.10.0"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "src/generated"
  ]
}
