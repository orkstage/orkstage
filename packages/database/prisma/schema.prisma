// Control-plane database. The database records DESIRED and KNOWN state; providers hold ACTUAL
// state (spec §61, §93). Every tenant-owned row carries an explicit tenantId (spec §12).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

enum PlatformRole {
  PlatformOwner
  PlatformAdmin
  PlatformOperator
}

enum TenantRole {
  CustomerOwner
  CustomerAdmin
  CustomerDeveloper
  CustomerViewer
}

model User {
  id           String        @id @default(uuid(7)) @db.Uuid
  email        String        @unique
  name         String
  platformRole PlatformRole?
  disabledAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  memberships        Membership[]
  externalIdentities ExternalIdentity[]
  sessions           Session[]
  notifications      Notification[]
  preferences        NotificationPreference[]
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenants Tenant[]
}

model Tenant {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  slug           String   @unique
  /// Optional limits (see @orkstage/domain TenantLimits, ADR 0007); a missing field is no limit.
  limits         Json     @default("{}")
  /// Email domains allowed to join via enterprise SSO, e.g. ["acme.com"].
  allowedEmailDomains String[] @default([])
  /// Policy of this tenant (open item 12). It only tightens the platform policy.
  policy         Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  invitations  Invitation[]
  instances    Instance[]
  incidents    Incident[]
  cloudTargets CloudTarget[]
  profiles     Profile[]
  statusPage   StatusPage?

  @@index([organizationId])
}

model Membership {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Invitation {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @db.Uuid
  email      String
  role       TenantRole
  /// SHA-256 of the invitation token; the token itself is only ever emailed.
  tokenHash  String     @unique
  expiresAt  DateTime   @db.Timestamptz(3)
  acceptedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model IdentityProvider {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Stable key used in URLs, e.g. "entra", "google".
  key       String   @unique
  kind      String
  name      String
  issuer    String
  clientId  String
  /// Reference into the secret store; the client secret never lives in this table.
  clientSecretRef String
  scopes    String[] @default(["openid", "email", "profile"])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  identities ExternalIdentity[]
}

model ExternalIdentity {
  id         String   @id @default(uuid(7)) @db.Uuid
  providerId String   @db.Uuid
  /// The provider's subject claim. Stored separately from internal user ids (spec §14).
  subject    String
  userId     String   @db.Uuid
  email      String?
  lastLoginAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  provider IdentityProvider @relation(fields: [providerId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@index([userId])
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 of the opaque session token held in the cookie.
  tokenHash  String    @unique
  method     String
  ip         String?
  userAgent  String?
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Templates ─────────────────────────────

enum TemplateVisibility {
  SYSTEM
  ORGANIZATION
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

model Template {
  id          String             @id @default(uuid(7)) @db.Uuid
  name        String             @unique
  displayName String
  description String             @default("")
  visibility  TemplateVisibility @default(ORGANIZATION)
  createdById String?            @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  versions TemplateVersion[]
  listing  MarketplaceListing?
}

/// Published versions are immutable (spec §7, §71). Edits create a new DRAFT version.
model TemplateVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  templateId    String                @db.Uuid
  version       String
  status        TemplateVersionStatus @default(DRAFT)
  /// Original YAML as authored.
  source        String
  /// Parsed, defaults-applied template document.
  document      Json
  validation    Json?
  publishedAt   DateTime?             @db.Timestamptz(3)
  publishedById String?               @db.Uuid
  /// Deprecated versions keep their instances running; new instances and upgrades cannot use them.
  deprecatedAt  DateTime?             @db.Timestamptz(3)
  deprecationNote String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  template  Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Plus a trigger in SQL (migration 20261018110000): the source and document of a version that
  // is not a draft never change.
  instances Instance[]

  @@unique([templateId, version])
}

// ───────────────────────────── Application catalog ─────────────────────────────

model Application {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Referenced by templates as catalog://<name>.
  name        String   @unique
  displayName String
  registryKind String  @default("ecr")
  repository  String
  port        Int
  healthPath  String   @default("/health")
  readinessPath String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  versions ApplicationVersion[]
}

model ApplicationVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @db.Uuid
  version       String
  imageUri      String
  /// Immutable image digest (sha256:...). Mutable tags alone are never deployed (spec §10).
  digest        String
  architectures String[] @default(["amd64"])
  scanStatus    String   @default("UNKNOWN")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
}

// ───────────────────────────── Cloud targets ─────────────────────────────

enum CloudProvider {
  aws
  azure
  gcp
  oci
  digitalocean
  vultr
  coreweave
  magalu
  vercel
  render
  supabase
  mock
}

enum TargetStatus {
  ACTIVE
  DISABLED
}

/// An AWS account, Azure subscription, GCP project, OCI compartment or platform team (spec §42.5).
model CloudTarget {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Null for platform-shared targets; set when a target belongs to one tenant.
  tenantId       String?       @db.Uuid
  provider       CloudProvider
  name           String
  /// The instance environment this target serves (production, staging, development, sandbox) or any.
  environment    String        @default("any")
  /// Non-secret configuration (account id, role ARN, subscription id, simulation settings).
  config         Json
  /// Reference into the secret store. Raw credentials are never stored here (spec §11).
  credentialRef  String?
  allowedRegions String[]
  defaultRegion  String
  allowedServices String[]     @default([])
  maxConcurrentDeployments Int @default(3)
  status         TargetStatus  @default(ACTIVE)
  health         String        @default("UNKNOWN")
  lastValidation Json?
  lastValidatedAt DateTime?    @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  profileTargets ProfileTarget[]

  @@index([tenantId])
}

/// A named setup for an environment: the cloud target, and optionally the region, to use for each
/// provider (ADR 0007). A new instance binds the slots it leaves unbound from its profile, or from
/// the default profile of its environment. Names are unique per tenant scope ignoring case, and
/// there is one default per tenant scope and environment (both are SQL indexes).
model Profile {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for profiles that platform staff share with every tenant.
  tenantId    String?  @db.Uuid
  name        String
  /// production, staging, development, sandbox or any.
  environment String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targets   ProfileTarget[]
  instances Instance[]

  @@index([tenantId])
}

/// One provider of a profile: the target to use, and the region (null: the target's default).
model ProfileTarget {
  profileId String        @db.Uuid
  provider  CloudProvider
  targetId  String        @db.Uuid
  region    String?

  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  target  CloudTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([profileId, provider])
  @@index([targetId])
}

// ───────────────────────────── Instances & deployments ─────────────────────────────

enum InstanceStatus {
  DRAFT
  VALIDATING
  PLANNING
  AWAITING_APPROVAL
  PROVISIONING
  DEPLOYING
  CONFIGURING
  VERIFYING
  READY
  VALIDATION_FAILED
  PLAN_FAILED
  PROVISION_FAILED
  DEPLOY_FAILED
  VERIFICATION_FAILED
  DEGRADED
  DESTROYING
  DESTROY_FAILED
  DESTROYED
}

enum HealthState {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
  MAINTENANCE
}

/// A logical customer environment composed of many resources, possibly across clouds (spec §2).
model Instance {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  name              String
  slug              String
  environment       String         @default("production")
  status            InstanceStatus @default(DRAFT)
  health            HealthState    @default(UNKNOWN)
  templateVersionId String         @db.Uuid
  /// Variable values supplied for the template.
  variables         Json           @default("{}")
  /// Labels (key → value), added as tags to every cloud resource (open item 12).
  labels            Json           @default("{}")
  /// Placement slot → { targetId, region }.
  bindings          Json
  /// The profile the unbound slots were bound from at creation; editing it later moves nothing.
  profileId         String?        @db.Uuid
  desiredStateHash  String?
  protectedFromDestroy Boolean     @default(false)
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  templateVersion TemplateVersion     @relation(fields: [templateVersionId], references: [id])
  profile         Profile?            @relation(fields: [profileId], references: [id], onDelete: SetNull)
  resources       InstanceResource[]
  deployments     Deployment[]
  transitions     InstanceTransition[]
  components      StatusComponent[]
  triggerRuns     TriggerRun[]
  domains         Domain[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

/// Every lifecycle transition is persisted (spec §15).
model InstanceTransition {
  id           String         @id @default(uuid(7)) @db.Uuid
  instanceId   String         @db.Uuid
  tenantId     String         @db.Uuid
  from         InstanceStatus
  to           InstanceStatus
  deploymentId String?        @db.Uuid
  reason       String?
  at           DateTime       @default(now()) @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, at])
}

enum ResourceStatus {
  PENDING
  ACTIVE
  FAILED
  DELETED
}

enum KnowledgeState {
  DESIRED
  KNOWN
  ACTUAL
  UNKNOWN
}

enum DriftStatus {
  IN_SYNC
  DRIFT_DETECTED
  REMEDIATION_PENDING
  REMEDIATION_FAILED
  UNKNOWN
}

model InstanceResource {
  id                 String         @id @default(uuid(7)) @db.Uuid
  tenantId           String         @db.Uuid
  instanceId         String         @db.Uuid
  /// Logical id from the template, e.g. "api".
  resourceId         String
  type               String
  slot               String
  provider           CloudProvider
  simulatedProvider  String?
  targetId           String         @db.Uuid
  region             String
  capability         String
  capabilityName     String
  name               String
  critical           Boolean        @default(true)
  providerResourceId String?
  specHash           String?
  idempotencyKey     String?
  outputs            Json           @default("{}")
  status             ResourceStatus @default(PENDING)
  knowledge          KnowledgeState @default(DESIRED)
  health             HealthState    @default(UNKNOWN)
  healthMessage      String?
  healthCheckedAt    DateTime?      @db.Timestamptz(3)
  consecutiveHealthFailures Int     @default(0)
  drift              DriftStatus    @default(UNKNOWN)
  driftCheckedAt     DateTime?      @db.Timestamptz(3)
  /// Last drift scan: changes the provider would make to restore the applied configuration.
  driftDetails       Json?
  /// Last backup check of a database (open item 18): what the provider reported, and when we warned.
  backupState        Json?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, resourceId])
  @@index([tenantId])
  @@index([status, healthCheckedAt])
}

enum DeploymentKind {
  APPLY
  DESTROY
}

enum DeploymentStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  PARTIALLY_FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum TriggerSource {
  MANUAL
  SCHEDULE
  WEBHOOK
}

enum TriggerRunStatus {
  /// Disruptive action on a production instance: waits for a person with the approval permission (ADR 0009).
  AWAITING_APPROVAL
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// One run of a template trigger: an action (redeploy, restart, purge cache) on one resource.
model TriggerRun {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @db.Uuid
  instanceId    String           @db.Uuid
  trigger       String
  resourceId    String
  action        String
  /// Template defaults merged with the overridable parameters the caller sent. Never secrets.
  params        Json             @default("{}")
  source        TriggerSource
  status        TriggerRunStatus @default(QUEUED)
  requestedById String?          @db.Uuid
  apiKeyId      String?          @db.Uuid
  correlationId String
  /// Provider id of what the action started (a deployment, a backup).
  reference     String?
  url           String?
  message       String?
  errorClass    String?
  approvedById  String?          @db.Uuid
  approvedAt    DateTime?        @db.Timestamptz(3)
  queuedAt      DateTime         @default(now()) @db.Timestamptz(3)
  startedAt     DateTime?        @db.Timestamptz(3)
  finishedAt    DateTime?        @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, queuedAt])
  @@index([tenantId, queuedAt])
}

model Deployment {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @db.Uuid
  instanceId        String           @db.Uuid
  kind              DeploymentKind
  status            DeploymentStatus @default(QUEUED)
  templateVersionId String           @db.Uuid
  requestedById     String?          @db.Uuid
  correlationId     String
  /// tenant + instance + desired state hash; prevents duplicate concurrent runs (spec §35).
  operationKey      String
  simulated         Boolean          @default(false)
  approvalRequired  Boolean          @default(false)
  approvedById      String?          @db.Uuid
  approvedAt        DateTime?        @db.Timestamptz(3)
  cancelRequestedAt DateTime?        @db.Timestamptz(3)
  /// Resources to (re)run on a retry; empty means all.
  onlyResources     String[]         @default([])
  retryOfId         String?          @db.Uuid
  /// How this apply is released and watched (ADR 0009): { strategy, trafficPercent, bakeMinutes, autoRollback }.
  release           Json?
  /// End of the bake period; the worker watches the instance until then.
  bakeUntil         DateTime?        @db.Timestamptz(3)
  /// Stayed healthy through its bake period (or had none): a target for smart rollback.
  verifiedAt        DateTime?        @db.Timestamptz(3)
  /// An incident or an unhealthy service during the bake period.
  bakeFailedAt      DateTime?        @db.Timestamptz(3)
  bakeFailure       String?
  /// This deployment returns the instance to that earlier deployment's configuration.
  rollbackToId      String?          @db.Uuid
  resolved          Json?
  plan              Json?
  cost              Json?
  outputs           Json?
  errorClass        String?
  errorMessage      String?
  queuedAt          DateTime         @default(now()) @db.Timestamptz(3)
  startedAt         DateTime?        @db.Timestamptz(3)
  finishedAt        DateTime?        @db.Timestamptz(3)

  instance Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  steps    DeploymentStep[]
  events   DeploymentEvent[]

  @@index([tenantId, queuedAt])
  @@index([instanceId, queuedAt])
  @@index([operationKey])
}

model DeploymentStep {
  id           String     @id @default(uuid(7)) @db.Uuid
  deploymentId String     @db.Uuid
  /// "phase:<name>" for workflow phases, otherwise the logical resource id.
  key          String
  kind         String
  name         String
  position     Int
  status       StepStatus @default(PENDING)
  attempt      Int        @default(0)
  provider     String?
  region       String?
  errorClass   String?
  errorMessage String?
  startedAt    DateTime?  @db.Timestamptz(3)
  finishedAt   DateTime?  @db.Timestamptz(3)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, key])
}

model DeploymentEvent {
  id           BigInt   @id @default(autoincrement())
  deploymentId String   @db.Uuid
  at           DateTime @default(now()) @db.Timestamptz(3)
  level        String
  stepKey      String?
  message      String
  data         Json?

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, id])
}

model HealthCheckResult {
  id         BigInt      @id @default(autoincrement())
  tenantId   String      @db.Uuid
  instanceId String      @db.Uuid
  resourceId String
  state      HealthState
  latencyMs  Int?
  message    String?
  checkedAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([instanceId, checkedAt])
  @@index([tenantId, checkedAt])
  @@index([checkedAt])
}

// ───────────────────────────── Status & incidents ─────────────────────────────

enum StatusState {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
  UNKNOWN
}

model StatusComponent {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @db.Uuid
  instanceId  String      @db.Uuid
  name        String
  /// Logical resource ids whose health drives this component.
  resourceIds String[]
  critical    Boolean     @default(true)
  status      StatusState @default(UNKNOWN)
  position    Int         @default(0)
  /// Set by the tenant on its status page settings; the worker never changes these three.
  label       String?
  hidden      Boolean     @default(false)
  sortOrder   Int?
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, name])
  @@index([tenantId])
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSource {
  MANUAL
  AUTOMATED
}

model Incident {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  instanceId   String?        @db.Uuid
  title        String
  status       IncidentStatus @default(INVESTIGATING)
  impact       StatusState    @default(DEGRADED)
  severity     String         @default("medium")
  source       IncidentSource @default(MANUAL)
  /// Groups repeated alerts into one open incident (alert-storm protection, spec §27).
  dedupKey     String?
  componentIds String[]       @default([])
  deploymentId String?        @db.Uuid
  openedAt     DateTime       @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?      @db.Timestamptz(3)
  createdById  String?        @db.Uuid

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  updates IncidentUpdate[]

  @@index([tenantId, openedAt])
  @@index([dedupKey, status])
  // Plus a partial unique index in SQL (migration 20261011090000): one unresolved incident per
  // dedupKey, so concurrent health ticks cannot open duplicates.
}

model IncidentUpdate {
  id          String         @id @default(uuid(7)) @db.Uuid
  incidentId  String         @db.Uuid
  status      IncidentStatus
  message     String
  createdById String?        @db.Uuid
  at          DateTime       @default(now()) @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at])
}

/// Planned work (spec §27, §52). While it runs, the components it names (all of the instance, or
/// of every instance of the tenant, when none are named) show MAINTENANCE and open no incidents.
model MaintenanceWindow {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  instanceId     String?   @db.Uuid
  title          String
  message        String?
  componentNames String[]  @default([])
  startsAt       DateTime  @db.Timestamptz(3)
  endsAt         DateTime  @db.Timestamptz(3)
  /// When subscribers were told it started and ended.
  startedAt      DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, startsAt])
  @@index([endsAt])
}

enum StatusVisibility {
  /// Platform staff and the tenant's owners and admins.
  PRIVATE
  /// Every member of the tenant (the default).
  CUSTOMER_ONLY
  /// Also anyone with the address `/s/<slug>`, without signing in.
  PUBLIC
}

/// Status page settings of a tenant (spec §26, §52). No row means the defaults.
model StatusPage {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @unique @db.Uuid
  visibility  StatusVisibility @default(CUSTOMER_ONLY)
  /// Public address; required while the page is public.
  slug        String?          @unique
  title       String?
  description String?
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions StatusSubscription[]
}

/// Email updates about incidents and maintenance. Confirmed by a link, except for a signed in
/// member subscribing their own address.
model StatusSubscription {
  id           String    @id @default(uuid(7)) @db.Uuid
  statusPageId String    @db.Uuid
  email        String
  /// The member who subscribed; null for a subscription from the public page.
  userId       String?   @db.Uuid
  /// sha256 of the token in the confirm and unsubscribe links.
  tokenHash    String    @unique
  confirmedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, email])
}

/// Alert rules are data, not code (spec §29). Null tenantId = platform default rule.
model AlertRule {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String?  @db.Uuid
  name          String
  /// { signal: "health", resourceTypes?: [...], consecutiveFailures: n } or metric thresholds.
  condition     Json
  severity      String
  actions       String[]
  cooldownSeconds Int    @default(900)
  autoResolve   Boolean  @default(true)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String?   @db.Uuid
  userId    String    @db.Uuid
  event     String
  title     String
  body      String
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
}

model NotificationPreference {
  id      String  @id @default(uuid(7)) @db.Uuid
  userId  String  @db.Uuid
  event   String
  channel String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event, channel])
}

model NotificationDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  notificationId String    @db.Uuid
  channel        String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ───────────────────────────── Governance ─────────────────────────────

/// Append-only. UPDATE and DELETE are blocked by a database trigger (spec §38).
model AuditEvent {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now()) @db.Timestamptz(3)
  actorId       String?  @db.Uuid
  actorType     String
  actorLabel    String?
  tenantId      String?  @db.Uuid
  resourceType  String
  resourceId    String?
  action        String
  result        String
  ip            String?
  userAgent     String?
  correlationId String?
  changes       Json?

  @@index([tenantId, at])
  @@index([resourceType, resourceId])
}

// ───────────────────────────── Integrations ─────────────────────────────

/// Machine credentials for the API (docs/specs/integration-api.md). Only the SHA-256 of the
/// token is stored; the token is shown once. Tenant keys act inside one tenant with a customer
/// role; organization keys (tenantId null) act with a platform role.
model ApiKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  tenantId       String?   @db.Uuid
  name           String
  /// Public, displayable part, e.g. "ork_live_7f3a9c21".
  prefix         String    @unique
  tokenHash      String    @unique
  role           String
  scopes         String[]
  createdById    String    @db.Uuid
  expiresAt      DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  lastUsedAt     DateTime? @db.Timestamptz(3)
  lastUsedIp     String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@index([tenantId])
}

enum WebhookFormat {
  ORKSTAGE
  SLACK
  TEAMS
}

model WebhookEndpoint {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @db.Uuid
  /// Null = receives events of every tenant in the organization (platform staff only).
  tenantId            String?  @db.Uuid
  url                 String
  description         String   @default("")
  events              String[]
  /// Signing secret, encrypted at rest (AES-256-GCM). Needed in clear to sign deliveries.
  secretEncrypted     String
  /// ORKSTAGE: signed JSON. SLACK and TEAMS: a chat message to an incoming webhook (open item 16).
  format              WebhookFormat @default(ORKSTAGE)
  enabled             Boolean  @default(true)
  consecutiveFailures Int      @default(0)
  disabledReason      String?
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@index([tenantId])
}

/// Outbox of webhook deliveries; the worker sends and retries them.
model WebhookDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  endpointId     String    @db.Uuid
  event          String
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  responseStatus Int?
  lastError      String?
  nextAttemptAt  DateTime  @default(now()) @db.Timestamptz(3)
  deliveredAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// Result of importing existing IaC (Terraform, CloudFormation, ...) into an OrkStage template.
model ImportJob {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  tenantId       String?  @db.Uuid
  createdById    String   @db.Uuid
  sourceKinds    String[]
  report         Json
  validation     Json
  templateId     String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
}

model FeatureFlag {
  id       String  @id @default(uuid(7)) @db.Uuid
  key      String
  tenantId String? @db.Uuid
  enabled  Boolean

  @@unique([key, tenantId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum ListingStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNLISTED
}

/// VERIFIED: reviewed by platform staff (policies, security, cost). DEVOPS: reviewed for operations
/// readiness (backups, observability, health checks, safe defaults).
enum ListingBadge {
  VERIFIED
  DEVOPS
}

/// A template offered in the marketplace: discovery metadata and review state on top of a template.
model MarketplaceListing {
  id            String         @id @default(uuid(7)) @db.Uuid
  templateId    String         @unique @db.Uuid
  slug          String         @unique
  title         String
  summary       String
  /// Plain text, paragraphs separated by blank lines.
  description   String         @default("")
  categories    String[]       @default([])
  tags          String[]       @default([])
  badges        ListingBadge[] @default([])
  status        ListingStatus  @default(PENDING_REVIEW)
  /// Shown as the author (a person, a team or OrkStage for curated listings).
  publisherName String
  submittedById String?        @db.Uuid
  reviewedById  String?        @db.Uuid
  reviewNotes   String?
  reviewedAt    DateTime?      @db.Timestamptz(3)
  publishedAt   DateTime?      @db.Timestamptz(3)
  /// Times someone started an instance or a copy from this listing.
  useCount      Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  template Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stars    MarketplaceStar[]

  @@index([status, publishedAt])
}

model MarketplaceStar {
  listingId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, userId])
  @@index([userId])
}

enum DomainKind {
  /// The subdomain OrkStage creates in the platform zone (the `dns` resource).
  PLATFORM
  /// A hostname the tenant owns, attached after its ownership is verified.
  CUSTOM
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
}

enum CertificateStatus {
  NONE
  PENDING_VALIDATION
  ISSUED
  EXPIRING
  EXPIRED
  FAILED
}

/// A hostname served by an instance (spec §23, open item 9). Hostnames are unique across the
/// platform: a hostname attached to one tenant cannot be claimed by another.
model Domain {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @db.Uuid
  instanceId           String            @db.Uuid
  /// Logical id of the resource that serves it (`dns` or `web.frontend`).
  resourceId           String
  hostname             String            @unique
  kind                 DomainKind
  status               DomainStatus      @default(PENDING_VERIFICATION)
  /// Value of the TXT record `_orkstage-challenge.<hostname>` that proves ownership.
  verificationToken    String
  verifiedAt           DateTime?         @db.Timestamptz(3)
  lastCheckedAt        DateTime?         @db.Timestamptz(3)
  lastError            String?
  certificateStatus    CertificateStatus @default(NONE)
  certificateExpiresAt DateTime?         @db.Timestamptz(3)
  /// DNS records the certificate authority needs (name, type, value), when the tenant must add them.
  certificateRecords   Json              @default("[]")
  /// The last expiry warning sent (days before expiry), so each one goes out once.
  expiryNoticeDays     Int?
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([instanceId])
  @@index([status, lastCheckedAt])
}
