{
  "name": "@co/cloud-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/contract.d.ts",
      "default": "./dist/testing/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@co/domain": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
