{
  "name": "orkstage-site",
  "private": true,
  "version": "0.1.0",
  "description": "orkstage.io: landing page and documentation (static export for S3 + CloudFront)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/generate-api-reference.mjs",
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/generate-api-reference.mjs",
    "build": "next build",
    "pretypecheck": "node scripts/generate-api-reference.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "openapi:refresh": "node scripts/refresh-openapi.mjs && node scripts/generate-api-reference.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "fumadocs-core": "16.16.1",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-openapi": "12.3.0",
    "fumadocs-ui": "16.16.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
